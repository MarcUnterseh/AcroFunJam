# Base URL of the AcroFunJam API. Default: same origin, through the Vite dev proxy
# (target configurable with API_PROXY_TARGET, default http://localhost:5252).
# Must stay on the SAME ORIGIN as the site: the session cookie is SameSite=Strict and sent with
# credentials 'same-origin' (ADR 0011). Another origin would need CORS and an anti-CSRF token.
# VITE_API_URL=https://acrofunjam.example
