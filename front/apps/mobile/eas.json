{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:5252"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "e2e": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:5253"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
