# Model of /opt/acrofunjam/.env on the server (ADR 0040, docs/deploiement.md). Never commit the real file.

# Domain of the site and of the API (same origin): Caddy obtains its certificate.
DOMAIN=acrofunjam.example.org

# Owner of the images on ghcr.io, in lower case; IMAGE_TAG is written by the deployment.
IMAGE_OWNER=marcunterseh
IMAGE_TAG=

# Long random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com, a token « Object Read & Write » on the bucket.
PHOTO_STORAGE_URL=
PHOTO_STORAGE_BUCKET=acrofunjam-photos
PHOTO_STORAGE_ACCESS_KEY=
PHOTO_STORAGE_SECRET_KEY=

# Nightly backups of the database (deploy/backup.sh): another bucket, another token.
BACKUP_BUCKET=acrofunjam-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# First administrator (ADR 0008): sign up on the site, then fill in this address and run « docker compose up -d ».
INITIAL_ADMINISTRATOR_EMAIL=
